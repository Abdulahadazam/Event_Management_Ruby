<header class="sticky top-0 bg-white border-b border-gray-200 z-50 shadow-sm backdrop-blur-lg bg-white/95">
  <div class="w-full px-4 sm:px-8 lg:px-16">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <%= link_to root_path, class: "flex items-center gap-3 hover:opacity-80 transition-opacity flex-shrink-0 group" do %>
        <div class="w-10 h-10 bg-indigo-600 rounded-lg flex items-center justify-center shadow-md group-hover:shadow-lg group-hover:bg-indigo-700 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-white">
            <path d="M8 2v4"></path>
            <path d="M16 2v4"></path>
            <rect width="18" height="18" x="3" y="4" rx="2"></rect>
            <path d="M3 10h18"></path>
          </svg>
        </div>
        <h1 class="text-xl sm:text-2xl font-bold text-gray-900">EventHub</h1>
      <% end %>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 flex-shrink-0">
        <%= link_to "Browse Events", events_path, class: "inline-flex items-center justify-center gap-2 rounded-lg text-sm font-medium h-10 px-4 text-gray-700 hover:text-indigo-600 hover:bg-gray-100 transition-all" %>
        <% if user_signed_in? %>
          <%= link_to tickets_path, class: "inline-flex items-center justify-center gap-2 rounded-lg text-sm font-medium h-10 px-4 text-gray-700 hover:text-indigo-600 hover:bg-gray-100 transition-all relative" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
            My Tickets
            <% ticket_count = current_user.tickets.where(status: 'paid').count %>
            <% if ticket_count > 0 %>
              <span class="absolute -top-1 -right-1 bg-indigo-600 text-white text-xs font-bold px-1.5 py-0.5 rounded-full min-w-[20px] text-center"><%= ticket_count %></span>
            <% end %>
          <% end %>
        <% end %>
        <%= link_to "About", about_path, class: "inline-flex items-center justify-center gap-2 rounded-lg text-sm font-medium h-10 px-4 text-gray-700 hover:text-indigo-600 hover:bg-gray-100 transition-all" %>
      </nav>

      <!-- Right Side Actions -->
      <div class="flex items-center gap-3 flex-shrink-0">

        <!-- Request Event Button -->
        <%= link_to new_event_request_path, class: "hidden sm:inline-flex items-center justify-center gap-2 rounded-lg text-sm font-semibold h-10 px-4 bg-indigo-600 text-white hover:bg-indigo-700 transition-all shadow-sm hover:shadow-md" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="M12 5v14"></path>
          </svg>
          <span>Request Event</span>
        <% end %>

        <!-- Auth / Profile -->
        <% if user_signed_in? %>
          <%= render 'shared/profile_dropdown' %>
        <% else %>
          <%= render 'shared/auth_buttons' %>
        <% end %>
      </div>
    </div>
  </div>
</header>