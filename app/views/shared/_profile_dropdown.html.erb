<div class="relative" data-controller="dropdown">
  <button data-action="click->dropdown#toggle" class="flex items-center gap-2 focus:outline-none hover:opacity-90 transition">
    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-indigo-600 font-bold text-sm shadow-md hover:shadow-lg transition">
      <%= user_initials(current_user) %>
    </div>
    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-72 bg-white rounded-lg shadow-2xl border border-gray-100 overflow-hidden z-50">
    <div class="px-5 py-4 bg-indigo-50 border-b border-indigo-100">
      <div class="flex items-center gap-3">
        <div class="w-14 h-14 bg-indigo-600 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-md flex-shrink-0">
          <%= user_initials(current_user) %>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-bold text-gray-900 mb-0.5">User</p>
          <p class="text-xs text-gray-600 truncate"><%= current_user.email %></p>
        </div>
      </div>
    </div>

    <div class="py-2">
      <%= link_to edit_user_registration_path, class: "flex items-center px-5 py-3 text-sm text-gray-700 hover:bg-gray-50 transition" do %>
        <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>Edit Profile</span>
      <% end %>

      <%= link_to "#", class: "flex items-center px-5 py-3 text-sm text-gray-700 hover:bg-gray-50 transition" do %>
        <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path>
        </svg>
        <span>My Tickets</span>
      <% end %>

      <%= link_to new_event_request_path, class: "flex items-center px-5 py-3 text-sm text-gray-700 hover:bg-gray-50 transition" do %>
        <svg class="w-5 h-5 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Create Event</span>
      <% end %>

      <div class="border-t border-gray-100 my-2"></div>

      <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "flex items-center px-5 py-3 text-sm text-red-600 hover:bg-red-50 transition" do %>
        <svg class="w-5 h-5 mr-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        <span>Logout</span>
      <% end %>
    </div>
  </div>
</div>