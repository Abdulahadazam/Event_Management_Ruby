<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        background-color: #f5f5f5;
      }
      .email-container {
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .email-header {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 30px 20px;
        text-align: center;
      }
      .email-header h1 {
        margin: 0;
        font-size: 24px;
        font-weight: bold;
      }
      .email-body {
        padding: 30px 20px;
      }
      .ticket-info {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        border: 2px solid #f59e0b;
        border-radius: 12px;
        padding: 20px;
        margin: 20px 0;
        text-align: center;
      }
      .ticket-number {
        font-size: 24px;
        font-weight: bold;
        color: #92400e;
        margin: 10px 0;
      }
      .ticket-type {
        display: inline-block;
        background: #f59e0b;
        color: white;
        padding: 6px 16px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 14px;
        margin: 10px 0;
      }
      .event-info {
        background-color: #f9fafb;
        border-left: 4px solid #6366f1;
        padding: 20px;
        margin: 20px 0;
        border-radius: 8px;
      }
      .event-title {
        font-size: 20px;
        font-weight: bold;
        color: #111827;
        margin-bottom: 10px;
      }
      .event-details {
        color: #6b7280;
        font-size: 14px;
        margin: 5px 0;
      }
      .payment-summary {
        background-color: #ecfdf5;
        border: 2px solid #10b981;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
      }
      .payment-row {
        display: flex;
        justify-content: space-between;
        margin: 10px 0;
        padding: 8px 0;
        border-bottom: 1px solid #d1fae5;
      }
      .payment-row:last-child {
        border-bottom: none;
        font-weight: bold;
        font-size: 18px;
        color: #059669;
      }
      .cta-button {
        display: inline-block;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
        padding: 16px 32px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        font-size: 16px;
        text-align: center;
        margin: 30px 0;
        box-shadow: 0 4px 6px rgba(99, 102, 241, 0.3);
      }
      .cta-container {
        text-align: center;
        margin: 30px 0;
      }
      .email-footer {
        background-color: #f9fafb;
        padding: 20px;
        text-align: center;
        color: #6b7280;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <div class="email-header">
        <h1>🎉 Payment Successful!</h1>
        <p style="margin: 10px 0 0 0; opacity: 0.9;">Your tickets are confirmed</p>
      </div>
      
      <div class="email-body">
        <p>Hello <%= @user.name || @user.email %>,</p>
        
        <p>Thank you for your purchase! Your payment has been processed successfully.</p>
        
        <!-- Ticket Information -->
        <div class="ticket-info">
          <div style="font-size: 14px; color: #92400e; margin-bottom: 8px;">TICKET NUMBER</div>
          <div class="ticket-number"><%= @ticket.ticket_number || "EVT-#{@ticket.event_id}-#{@ticket.id}" %></div>
          <div class="ticket-type"><%= @ticket.ticket_type || 'Standard' %></div>
          <div style="margin-top: 10px; color: #92400e; font-size: 14px;">
            Quantity: <%= @ticket.quantity %> ticket(s)
          </div>
        </div>
        
        <!-- Event Information -->
        <div class="event-info">
          <div class="event-title"><%= @event.title %></div>
          <% if @event.date.present? %>
            <div class="event-details">📅 <%= @event.date.strftime("%B %d, %Y at %I:%M %p") %></div>
          <% end %>
          <% if @event.location.present? %>
            <div class="event-details">📍 <%= @event.location %></div>
          <% end %>
        </div>
        
        <!-- Payment Summary -->
        <div class="payment-summary">
          <h3 style="margin-top: 0; color: #059669;">Payment Summary</h3>
          <div class="payment-row">
            <span>Ticket Type:</span>
            <span><%= @ticket.ticket_type || 'Standard' %></span>
          </div>
          <div class="payment-row">
            <span>Quantity:</span>
            <span><%= @ticket.quantity %> ticket(s)</span>
          </div>
          <div class="payment-row">
            <span>Total Amount:</span>
            <span>$<%= @ticket.total_amount %></span>
          </div>
          <div class="payment-row">
            <span>Payment Method:</span>
            <span><%= @ticket.payment_method&.upcase || 'STRIPE' %></span>
          </div>
          <div class="payment-row">
            <span>Status:</span>
            <span style="color: #10b981; font-weight: bold;">✓ Paid</span>
          </div>
        </div>
        
        <div class="cta-container">
          <% 
            host_options = Rails.application.config.action_mailer.default_url_options
            tickets_url = if host_options[:protocol] == 'https'
              "https://#{host_options[:host]}/my_tickets"
            else
              "http://#{host_options[:host]}:#{host_options[:port]}/my_tickets"
            end
          %>
          <a href="<%= tickets_url %>" class="cta-button" style="color: white; text-decoration: none;">View My Tickets</a>
        </div>
        
        <p style="color: #6b7280; font-size: 14px;">
          <strong>Important:</strong> Please save this email as your ticket confirmation. You may be asked to show this at the event entrance.
        </p>
      </div>
      
      <div class="email-footer">
        <p>© <%= Time.now.year %> EventHub. All rights reserved.</p>
        <p>This is an automated message, please do not reply to this email.</p>
      </div>
    </div>
  </body>
</html>


