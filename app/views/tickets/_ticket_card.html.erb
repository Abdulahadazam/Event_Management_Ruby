<div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
  <!-- Event Image -->
  <div class="relative h-48 bg-gradient-to-br from-indigo-500 to-purple-600">
    <% if ticket.event.banner.attached? %>
      <%= image_tag ticket.event.banner, alt: ticket.event.title, class: "w-full h-full object-cover" %>
    <% elsif ticket.event.image_url.present? %>
      <%= image_tag ticket.event.image_url, alt: ticket.event.title, class: "w-full h-full object-cover" %>
    <% end %>
    <div class="absolute top-4 right-4">
      <% if ticket.ticket_type == 'VIP' || ticket.ticket_type == 'Premium' %>
        <span class="px-3 py-1 bg-gradient-to-r from-yellow-400 to-orange-500 text-white text-xs font-bold rounded-full">VIP</span>
      <% end %>
    </div>
  </div>

  <!-- Ticket Info -->
  <div class="p-6">
    <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2"><%= ticket.event.title %></h3>
    
    <div class="space-y-2 mb-4">
      <% if ticket.event.date.present? %>
        <div class="flex items-center gap-2 text-sm text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 2v4"></path>
            <path d="M16 2v4"></path>
            <rect width="18" height="18" x="3" y="4" rx="2"></rect>
            <path d="M3 10h18"></path>
          </svg>
          <%= ticket.event.date.strftime("%B %d, %Y at %I:%M %p") %>
        </div>
      <% end %>
      
      <% if ticket.event.location.present? %>
        <div class="flex items-center gap-2 text-sm text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <%= ticket.event.location %>
        </div>
      <% end %>
    </div>

    <!-- Ticket Details -->
    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-xl p-4 mb-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-green-900">Ticket Number</span>
        <span class="text-sm font-mono font-bold text-green-700"><%= ticket.ticket_number || "EVT-#{ticket.event_id}-#{ticket.id}" %></span>
      </div>
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm text-green-800">Type</span>
        <span class="text-sm font-semibold text-green-900"><%= ticket.ticket_type || 'Standard' %></span>
      </div>
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm text-green-800">Quantity</span>
        <span class="text-sm font-semibold text-green-900"><%= ticket.quantity %> ticket(s)</span>
      </div>
      <div class="flex items-center justify-between pt-2 border-t border-green-200">
        <span class="text-sm font-semibold text-green-900">Total Paid</span>
        <span class="text-lg font-bold text-green-700">$<%= ticket.total_amount %></span>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex gap-2">
      <%= link_to ticket_path(ticket), class: "flex-1 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold text-sm text-center transition-colors" do %>
        View Details
      <% end %>
      <%= link_to event_path(ticket.event), class: "flex-1 py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-semibold text-sm text-center transition-colors" do %>
        View Event
      <% end %>
    </div>
  </div>
</div>



