<div class="min-h-screen bg-gray-50 flex flex-col">
  <%= render 'shared/header' %>

  <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
      <!-- Header -->
      <div class="bg-gradient-to-r from-orange-500 to-indigo-600 p-8 text-white">
        <h1 class="text-3xl font-bold mb-2">Complete Your Registration</h1>
        <p class="text-white/90">Purchase tickets for <%= @event.title %></p>
      </div>

      <div class="p-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          
          <!-- Event Details -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Event Details</h2>
            
            <div class="space-y-4 mb-8">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center flex-shrink-0 text-indigo-600">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 2v4"></path>
                    <path d="M16 2v4"></path>
                    <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                    <path d="M3 10h18"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide">Date & Time</h3>
                  <% if @event.date.present? %>
                    <p class="text-gray-900 font-medium mt-0.5"><%= @event.date.strftime("%B %d, %Y") %></p>
                    <p class="text-gray-500 text-sm"><%= @event.date.strftime("%A at %I:%M %p") %></p>
                  <% end %>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center flex-shrink-0 text-indigo-600">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide">Location</h3>
                  <p class="text-gray-900 font-medium mt-0.5"><%= @event.location %></p>
                </div>
              </div>
            </div>

            <% if @event.banner.attached? || @event.image_url.present? %>
              <div class="rounded-xl overflow-hidden">
                <% if @event.banner.attached? %>
                  <%= image_tag @event.banner, alt: @event.title, class: "w-full h-48 object-cover" %>
                <% else %>
                  <%= image_tag @event.image_url, alt: @event.title, class: "w-full h-48 object-cover" %>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Ticket Purchase Form -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Purchase Tickets</h2>
            
            <div data-controller="ticket-purchase" 
                 data-ticket-purchase-price-value="<%= @event.price %>" 
                 data-ticket-purchase-event-id-value="<%= @event.id %>">
              
              <!-- Registration Required Alert (shown if backend redirects user here) -->
              <% unless @is_registered %>
                <div class="mb-6 bg-gradient-to-r from-amber-50 to-orange-50 border-2 border-amber-300 rounded-xl p-5">
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 bg-amber-500 rounded-full flex items-center justify-center text-white flex-shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 9v4"></path>
                        <path d="M12 17h.01"></path>
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                      </svg>
                    </div>
                    <div class="flex-1">
                      <h3 class="font-bold text-amber-900 text-lg mb-1">Registration Required</h3>
                      <p class="text-amber-800 text-sm mb-4">You must register for this event before purchasing tickets. The backend will prevent ticket purchase without registration.</p>
                      <%= button_to "Register for Event", event_registrations_path(@event), method: :post, class: "w-full py-3 px-4 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white rounded-lg font-bold shadow-md transition-all transform hover:scale-[1.02] active:scale-95" %>
                    </div>
                  </div>
                </div>
              <% end %>
              
              <form data-action="submit->ticket-purchase#submitForm" class="space-y-6">
                <!-- Ticket Type Selection -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-3">Select Ticket Type</label>
                  <div class="grid grid-cols-1 gap-3">
                    <% @ticket_types.each do |type| %>
                      <% type_name = type.is_a?(Hash) ? type[:name] : type %>
                      <% type_price = type.is_a?(Hash) ? type[:price] : calculate_ticket_price(type_name, @event.price) %>
                      <% is_selected = (@selected_ticket_type == type_name) %>
                      <label class="relative flex items-center p-4 border-2 rounded-xl cursor-pointer transition-all <%= is_selected ? 'border-orange-500 bg-orange-50' : 'border-gray-200 hover:border-gray-300' %>">
                        <input 
                          type="radio" 
                          name="ticket_type" 
                          value="<%= type_name %>" 
                          data-action="change->ticket-purchase#onTicketTypeChange"
                          data-ticket-purchase-target="ticketType"
                          <%= 'checked' if is_selected %>
                          class="sr-only"
                        />
                        <div class="flex-1">
                          <div class="flex items-center justify-between">
                            <div>
                              <span class="font-bold text-gray-900 text-lg"><%= type_name %></span>
                              <% if type_name == 'VIP' || type_name == 'Premium' %>
                                <span class="ml-2 px-2 py-0.5 bg-gradient-to-r from-yellow-400 to-orange-500 text-white text-xs font-bold rounded-full">PREMIUM</span>
                              <% end %>
                            </div>
                            <span class="text-xl font-bold text-gray-900">$<%= type_price.round(2) %></span>
                          </div>
                          <% if type_name == 'VIP' %>
                            <p class="text-sm text-gray-600 mt-1">Premium seating, early access, exclusive perks</p>
                          <% elsif type_name == 'Premium' %>
                            <p class="text-sm text-gray-600 mt-1">Best seats, VIP lounge access, meet & greet</p>
                          <% else %>
                            <p class="text-sm text-gray-600 mt-1">Standard admission</p>
                          <% end %>
                        </div>
                        <% if is_selected %>
                          <div class="ml-4 w-6 h-6 rounded-full bg-orange-500 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                          </div>
                        <% end %>
                      </label>
                    <% end %>
                  </div>
                </div>
                
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-3">Number of Tickets</label>
                  <div class="border-2 border-gray-200 rounded-2xl flex items-center justify-between bg-gray-50 p-1">
                    <button 
                      type="button" 
                      data-action="click->ticket-purchase#decreaseQuantity"
                      class="w-12 h-12 flex items-center justify-center text-gray-500 hover:text-gray-900 hover:bg-white rounded-xl transition-all"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                      </svg>
                    </button>
                    
                    <input 
                      type="number" 
                      name="quantity"
                      data-ticket-purchase-target="quantity"
                      data-action="input->ticket-purchase#onQuantityChange"
                      min="1" 
                      max="10" 
                      value="<%= @quantity %>"
                      class="w-20 text-center bg-transparent border-none text-2xl font-bold text-gray-900 focus:ring-0 p-0"
                      required
                    />
                    
                    <button 
                      type="button"
                      data-action="click->ticket-purchase#increaseQuantity"
                      class="w-12 h-12 flex items-center justify-center text-indigo-600 hover:text-indigo-700 bg-white shadow-sm rounded-xl transition-all"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="M12 5v14"/>
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="bg-gradient-to-r from-orange-50 to-indigo-50 rounded-xl p-6 border-2 border-orange-200">
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-gray-700 font-medium">Price per ticket</span>
                    <span class="text-2xl font-bold text-gray-900" data-ticket-purchase-target="pricePerTicket">$<%= calculate_ticket_price(@selected_ticket_type, @event.price).round(2) %></span>
                  </div>
                  <div class="flex items-center justify-between pt-4 border-t-2 border-orange-200">
                    <span class="text-lg font-bold text-gray-900">Total Amount</span>
                    <span class="text-3xl font-extrabold text-orange-600" data-ticket-purchase-target="totalAmount">$<%= @total_amount.round(2) %></span>
                  </div>
                </div>

                <button 
                  type="submit"
                  data-ticket-purchase-target="submitButton"
                  class="w-full py-4 px-6 bg-gradient-to-r from-orange-500 to-indigo-600 hover:from-orange-600 hover:to-indigo-700 text-white rounded-xl font-bold shadow-lg shadow-orange-200 transition-all transform hover:scale-[1.02] active:scale-95 text-lg"
                >
                  Proceed to Payment
                </button>

                <div data-ticket-purchase-target="errorMessage" class="hidden bg-red-50 border-2 border-red-200 rounded-xl p-4 mb-4">
                  <div class="flex items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600 flex-shrink-0">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M12 8v4"></path>
                      <path d="M12 16h.01"></path>
                    </svg>
                    <p class="text-red-800 font-medium"></p>
                  </div>
                </div>
              </form>
            </div>
            
            <style>
              @keyframes slide-in {
                from {
                  transform: translateX(100%);
                  opacity: 0;
                }
                to {
                  transform: translateX(0);
                  opacity: 1;
                }
              }
              
              @keyframes slide-out {
                from {
                  transform: translateX(0);
                  opacity: 1;
                }
                to {
                  transform: translateX(100%);
                  opacity: 0;
                }
              }
              
              .animate-slide-in {
                animation: slide-in 0.3s ease-out;
              }
            </style>

            <div class="mt-8 p-4 bg-green-50 border border-green-200 rounded-xl">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600 flex-shrink-0 mt-0.5">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <div>
                  <p class="font-semibold text-green-900">Secure Payment</p>
                  <p class="text-sm text-green-700 mt-1">Your payment is secured by Stripe. We never store your card details.</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>

  <%= render 'shared/footer' %>
</div>

