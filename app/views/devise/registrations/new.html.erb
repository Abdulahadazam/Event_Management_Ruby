<!-- app/views/devise/registrations/new.html.erb -->
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-50 to-gray-100 py-10 px-4">
  <div class="w-full max-w-xl"> 
    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">

      <!-- Header -->
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-12 py-8 text-center">
        <%= link_to root_path, class: "inline-block mb-3" do %>
          <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600">
              <path d="M8 2v4"></path>
              <path d="M16 2v4"></path>
              <rect width="18" height="18" x="3" y="4" rx="2"></rect>
              <path d="M3 10h18"></path>
            </svg>
          </div>
        <% end %>
        <h2 class="text-3xl font-bold text-white mt-4">Join EventHub</h2>
        <p class="mt-1 text-indigo-100 text-sm">Discover and book amazing events near you</p>
      </div>

      <!-- Body -->
      <div class="px-12 py-8">

        <!-- Email verification notice -->
        <div class="bg-blue-50 border border-blue-400 rounded-lg p-4 mb-6 flex items-start">
          <svg class="h-5 w-5 text-blue-500 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
          <div>
            <p class="text-sm font-semibold text-blue-800">Email verification required</p>
            <p class="text-xs text-blue-600 mt-1">We'll email a confirmation link</p>
          </div>
        </div>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5", id: "signup-form" }, data: { turbo: false }) do |f| %>

          <!-- Server-side errors (shown after form submission) -->
          <% if resource.errors.any? %>
            <div class="bg-red-50 border-l-4 border-red-500 rounded-r-lg p-4 mb-4">
              <div class="flex items-start">
                <svg class="h-5 w-5 text-red-500 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                <div class="flex-1">
                  <h3 class="text-sm font-semibold text-red-800">
                    <%= pluralize(resource.errors.count, "error") %> prohibited this account from being saved:
                  </h3>
                  <ul class="mt-2 text-sm text-red-700 space-y-1 list-disc list-inside">
                    <% resource.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Name Field -->
          <div>
            <%= f.label :name, "Full Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
            <%= f.text_field :name, 
                autofocus: true, 
                autocomplete: "name",
                placeholder: "Enter your full name",
                class: "block w-full px-4 py-3 border #{resource.errors[:name].any? ? 'border-red-500' : 'border-gray-300'} rounded-lg placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition text-sm" %>
            <% if resource.errors[:name].any? %>
              <p class="mt-2 text-xs text-red-600"><%= resource.errors[:name].first %></p>
            <% end %>
          </div>
            
          <!-- Email Field with Validation -->
          <!-- data-controller="email-validation" → Activates the email validation controller -->
          <div data-controller="email-validation">
            <%= f.label :email, "Email Address", class: "block text-sm font-semibold text-gray-700 mb-2" %>
            <%= f.email_field :email,
              data: { 
                email_validation_target: "email",                      # ← Mark this as the "email" target
                action: "input->email-validation#validate"             # ← On "input" event, run validate() method
              },
              class: "w-full px-4 py-3 border #{resource.errors[:email].any? ? 'border-red-500' : 'border-gray-300'} rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition" %>
            
            <!-- Client-side email error (controlled by Stimulus) -->
            <p class="mt-2 text-xs text-red-600 hidden flex items-center" data-email-validation-target="error">
              <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
              </svg>
              Please enter a valid email address
            </p>

            <!-- Server-side email error -->
            <% if resource.errors[:email].any? %>
              <p class="mt-2 text-xs text-red-600"><%= resource.errors[:email].first %></p>
            <% end %>
          </div>

          <!-- Password Field with Real-time Validation -->
          <!-- data-controller="password-validation" → Activates the password validation controller -->
          <div data-controller="password-validation">
            <div class="flex justify-between mb-2">
              <%= f.label :password, "Password", class: "text-sm font-semibold text-gray-700" %>
            </div>
            <%= f.password_field :password,
              data: { 
                password_validation_target: "password",                # ← Mark this as the "password" target
                action: "input->password-validation#validate"          # ← On "input" event, run validate() method
              },
              class: "w-full px-4 py-3 border #{resource.errors[:password].any? ? 'border-red-500' : 'border-gray-300'} rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition" %>
            
            <!-- Password Requirements (Client-side validation messages) -->
            <div class="mt-3 space-y-2">
              <!-- Capital Letter Error -->
              <div class="hidden items-center text-xs" data-password-validation-target="capitalError">
                <svg class="w-4 h-4 text-red-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <span class="text-red-600">Must start with a capital letter</span>
              </div>

              <!-- Length Error -->
              <div class="hidden items-center text-xs" data-password-validation-target="lengthError">
                <svg class="w-4 h-4 text-red-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <span class="text-red-600">Must be at least 8 characters</span>
              </div>

              <!-- Sequential Numbers Error -->
              <div class="hidden items-center text-xs" data-password-validation-target="sequentialError">
                <svg class="w-4 h-4 text-red-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <span class="text-red-600">Cannot contain sequential numbers (123, 321, etc.)</span>
              </div>
            </div>

            <!-- Password Strength Indicator -->
            <div class="mt-3 hidden" data-password-validation-target="strength">
              <div class="flex justify-between items-center mb-1">
                <span class="text-xs text-gray-600">Password Strength:</span>
                <span class="strength-text text-xs font-semibold"></span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="strength-bar h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
              </div>
            </div>

            <!-- Server-side password errors -->
            <% if resource.errors[:password].any? %>
              <p class="mt-2 text-xs text-red-600"><%= resource.errors[:password].first %></p>
            <% end %>
          </div>

          <!-- Confirm Password -->
          <div>
            <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-semibold text-gray-700 mb-2" %>
            <%= f.password_field :password_confirmation,
              class: "w-full px-4 py-3 border #{resource.errors[:password_confirmation].any? ? 'border-red-500' : 'border-gray-300'} rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
            <% if resource.errors[:password_confirmation].any? %>
              <p class="mt-2 text-xs text-red-600"><%= resource.errors[:password_confirmation].first %></p>
            <% end %>
          </div>

          <div class="pt-2">
            <%= f.submit "Create Account", class: "w-full py-3 px-4 border border-transparent text-sm font-semibold rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors cursor-pointer" %>
          </div>

          <!-- Divider -->
          <div class="relative">
            <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-300"></div></div>
            <div class="relative flex justify-center">
              <span class="px-4 bg-white text-gray-500 text-sm">or continue with</span>
            </div>
          </div>

          <!-- Google Button -->
          <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false },
            class: "w-full flex items-center justify-center py-3 px-4 rounded-lg text-white font-semibold text-sm
                    bg-gradient-to-r from-indigo-600 to-purple-600 hover:opacity-90 transition" do %>
            <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Sign up with Google
          <% end %>

          <!-- Already have an account -->
          <p class="text-center text-sm mt-6">
            Already have an account?
            <%= link_to "Sign in", new_session_path(resource_name), class: "text-indigo-600 font-semibold hover:underline" %>
          </p>

        <% end %>
      </div>

      <!-- Footer -->
      <div class="bg-gray-50 px-12 py-4 text-center text-xs text-gray-500">
        By signing up, you agree to our
        <%= link_to "Terms", "#", class: "text-indigo-600" %> &
        <%= link_to "Privacy Policy", "#", class: "text-indigo-600" %>
      </div>

    </div>

    <!-- Back -->
    <div class="text-center mt-6">
      <%= link_to root_path, class: "text-gray-600 hover:text-indigo-600 text-sm font-medium" do %>
        ← Back to EventHub
      <% end %>
    </div>
  </div>
</div>